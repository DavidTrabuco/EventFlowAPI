# Copie este arquivo para ".env" (que ja fica fora do git) e preencha com
# valores reais antes de rodar "docker compose up".

# Precisa ter pelo menos 32 caracteres (regra do JwtOptions.Key).
# Gere um com: openssl rand -base64 32
JWT_KEY=

# O mesmo Client Secret configurado no Google Cloud Console pro OAuth.
GOOGLE_CLIENT_SECRET=

# Conta Gmail usada para enviar e-mails (via SMTP) e a senha de app gerada em
# myaccount.google.com/apppasswords (NAO e a senha normal da conta).
EMAIL_FROM=
EMAIL_APP_PASSWORD=
